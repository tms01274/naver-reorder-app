# 이 파일을 복사해서 .env 파일을 만들고 실제 값을 채워주세요.
# cp .env.example .env

# ── 실행 모드 ─────────────────────────────────────────
# true = 샘플(가짜) 데이터로 동작 (API 키 없이 바로 테스트 가능)
# false = 실제 네이버 커머스API로 연동
MOCK_MODE=true

# ── 네이버 커머스API 인증 정보 ────────────────────────
# 발급 방법: https://apicenter.commerce.naver.com 로그인 후
# [내 스토어 애플리케이션] 메뉴에서 애플리케이션 등록 -> client_id, client_secret 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 재주문 판단 기준 (기본값, 화면에서도 조정 가능) ───
# 최근 며칠간의 판매량으로 판매 속도를 계산할지
SALES_LOOKBACK_DAYS=14
# 발주 후 실제 입고까지 걸리는 평균 일수
DEFAULT_LEAD_TIME_DAYS=7
# 리드타임에 추가로 확보해두고 싶은 안전 여유일수
DEFAULT_SAFETY_BUFFER_DAYS=3

# ── 발주 메일 발신 정보 ───────────────────────────────
# 발주서의 {{보내는사람}} 에 들어갈 이름 (선택)
# 비워두면 한국어 발주서는 "아틀리에 말리", 영어·중국어 발주서는 "Atelier Mali"
SENDER_NAME=
SENDER_NAME_EN=

# ── 서버 포트 ─────────────────────────────────────────
PORT=3000
